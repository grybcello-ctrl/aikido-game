{
  "$schema": "../schema/technique.schema.json",
  "id": "shomenuchi_iriminage_ura",
  "version": 2,
  "name": { "ko": "정면타 입신던지기 (우라)", "ja": "正面打ち入身投げ（裏）", "en": "Shomenuchi Iriminage (Ura)" },
  "attack": "shomenuchi",
  "technique": "iriminage",
  "variant": "ura",
  "principles": ["maai", "musubi", "irimi", "tenkan", "kuzushi", "zanshin"],

  "requires": {
    "maai": { "minPx": 56, "idealPx": 72, "maxPx": 88 }
  },

  "animations": {
    "common": [
      "common.nage.kamae",
      "common.nage.zanshin",
      "common.nage.hit_head",
      "common.nage.whiff_hit",
      "common.nage.pushed_back",
      "common.uke.shomenuchi_windup",
      "common.uke.shomenuchi_strike",
      "common.uke.recover",
      "common.uke.ukemi_back",
      "common.uke.ukemi_sloppy",
      "common.uke.crash",
      "common.fx.hit_spark"
    ],
    "exclusive": {
      "tech.shomenuchi_iriminage_ura.nage.irimi_awase": {
        "actor": "nage", "atlas": "nage", "prefix": "iri_ura_awase_", "start": 0, "end": 3, "frameRate": 10,
        "origin": { "x": 0.5, "y": 1 },
        "frameOffsets": [{ "frame": 2, "x": 2, "y": -1 }],
        "events": [{ "frame": 2, "name": "contact" }]
      },
      "tech.shomenuchi_iriminage_ura.nage.tenkan": {
        "actor": "nage", "atlas": "nage", "prefix": "iri_ura_tenkan_", "start": 0, "end": 5, "frameRate": 10,
        "origin": { "x": 0.5, "y": 1 },
        "frameOffsets": [{ "frame": 3, "x": -2, "y": 0 }, { "frame": 4, "x": -4, "y": 0 }],
        "events": [{ "frame": 3, "name": "pivot" }]
      },
      "tech.shomenuchi_iriminage_ura.nage.lead_shoulder": {
        "actor": "nage", "atlas": "nage", "prefix": "iri_ura_lead_", "start": 0, "end": 7, "frameRate": 10,
        "origin": { "x": 0.5, "y": 1 }
      },
      "tech.shomenuchi_iriminage_ura.nage.throw_cut": {
        "actor": "nage", "atlas": "nage", "prefix": "iri_ura_cut_", "start": 0, "end": 4, "frameRate": 10,
        "origin": { "x": 0.5, "y": 1 },
        "events": [{ "frame": 2, "name": "cut" }]
      },
      "tech.shomenuchi_iriminage_ura.uke.drawn_around": {
        "actor": "uke", "atlas": "uke", "prefix": "iri_ura_drawn_", "start": 0, "end": 5, "frameRate": 10,
        "origin": { "x": 0.5, "y": 1 }
      },
      "tech.shomenuchi_iriminage_ura.uke.spiral_kuzushi": {
        "actor": "uke", "atlas": "uke", "prefix": "iri_ura_spiral_", "start": 0, "end": 7, "frameRate": 10,
        "origin": { "x": 0.5, "y": 1 },
        "frameOffsets": [{ "frame": 3, "x": 2, "y": 4 }, { "frame": 4, "x": 2, "y": 6 }],
        "events": [
          { "frame": 2, "name": "lead_1" },
          { "frame": 4, "name": "lead_2" },
          { "frame": 6, "name": "rise" }
        ]
      },
      "tech.shomenuchi_iriminage_ura.uke.thrown": {
        "actor": "uke", "atlas": "uke", "prefix": "iri_ura_thrown_", "start": 0, "end": 4, "frameRate": 10,
        "origin": { "x": 0.5, "y": 1 },
        "events": [{ "frame": 2, "name": "fall" }]
      },
      "tech.shomenuchi_iriminage_ura.fx.musubi_ring": {
        "actor": "fx", "atlas": "fx", "prefix": "musubi_ring_", "start": 0, "end": 5, "frameRate": 12,
        "origin": { "x": 0.5, "y": 0.5 }
      }
    }
  },

  "phases": [
    {
      "id": "maai",
      "stage": "recognition",
      "label": { "ko": "마아이 (공격 인지)", "ja": "間合い" },
      "principle": "maai",
      "durationMs": 500,
      "actors": {
        "nage": { "anim": "common.nage.kamae" },
        "uke":  { "anim": "common.uke.shomenuchi_windup" }
      },
      "tracks": {
        "nage": [{ "atMs": 0, "x": 0, "y": 0, "facing": 1, "depth": 10 }],
        "uke": [
          { "atMs": 0,   "x": 80, "y": 0, "facing": -1, "depth": 10 },
          { "atMs": 500, "x": 72, "y": 0, "ease": "Stepped" }
        ]
      },
      "input": { "type": "none" },
      "outcomes": { "auto": { "goto": "phase:awase" } }
    },
    {
      "id": "awase",
      "stage": "recognition",
      "label": { "ko": "아와세 · 이리미", "ja": "合わせ・入身" },
      "principle": "irimi",
      "durationMs": 400,
      "actors": {
        "nage": { "anim": "tech.shomenuchi_iriminage_ura.nage.irimi_awase" },
        "uke":  { "anim": "common.uke.shomenuchi_strike" }
      },
      "tracks": {
        "nage": [
          { "atMs": 0,   "x": 0,  "y": 0,  "depth": 10 },
          { "atMs": 200, "x": 16, "y": -4, "depth": 9, "ease": "Stepped" },
          { "atMs": 400, "x": 20, "y": -4 }
        ],
        "uke": [
          { "atMs": 0,   "x": 72, "y": 0 },
          { "atMs": 200, "x": 40, "y": 0, "ease": "Stepped" },
          { "atMs": 400, "x": 32, "y": 0 }
        ]
      },
      "input": {
        "type": "press",
        "button": "ACTION",
        "targetMs": 200,
        "sync": { "actor": "uke", "event": "impact" },
        "window": { "early": [-200, -50], "perfect": [-50, 50], "late": [50, 150] }
      },
      "outcomes": {
        "perfect": { "goto": "phase:tenkan", "score": 100, "musubi": 20, "hitstopMs": 120, "fx": "tech.shomenuchi_iriminage_ura.fx.musubi_ring" },
        "early":   { "goto": "branch:whiff_hit", "musubi": -10, "reaction": { "type": "whiff" } },
        "late":    { "goto": "branch:clash_pushback", "musubi": -10, "reaction": { "type": "clash", "px": 12 } },
        "miss":    { "goto": "branch:struck", "reaction": { "type": "hit" } }
      }
    },
    {
      "id": "tenkan",
      "stage": "entry",
      "label": { "ko": "텐칸 (뒤로 돌아 들어가기)", "ja": "転換" },
      "principle": "tenkan",
      "durationMs": 600,
      "actors": {
        "nage": { "anim": "tech.shomenuchi_iriminage_ura.nage.tenkan" },
        "uke":  { "anim": "tech.shomenuchi_iriminage_ura.uke.drawn_around" }
      },
      "tracks": {
        "nage": [
          { "atMs": 0,   "x": 20, "y": -4, "facing": 1, "depth": 9 },
          { "atMs": 300, "x": 36, "y": -4, "facing": -1, "ease": "Stepped" },
          { "atMs": 600, "x": 40, "y": -2 }
        ],
        "uke": [
          { "atMs": 0,   "x": 32,  "y": 0, "facing": -1, "depth": 10 },
          { "atMs": 300, "x": 8,   "y": 0, "ease": "Stepped" },
          { "atMs": 600, "x": -20, "y": 2 }
        ]
      },
      "input": {
        "type": "direction_press",
        "button": "ACTION",
        "direction": "BACK",
        "targetMs": 300,
        "sync": { "actor": "nage", "event": "pivot" },
        "window": { "early": [-180, -60], "perfect": [-60, 60], "late": [60, 180] }
      },
      "outcomes": {
        "perfect": { "goto": "phase:musubi", "score": 100, "musubi": 15, "hitstopMs": 100 },
        "early":   { "goto": "phase:musubi", "score": 30, "musubi": -10, "reaction": { "type": "whiff" } },
        "late":    { "goto": "phase:musubi", "score": 30, "musubi": -10, "reaction": { "type": "pushback", "px": 6 } },
        "miss":    { "goto": "branch:uke_escape" }
      }
    },
    {
      "id": "musubi",
      "stage": "entry",
      "label": { "ko": "무스비 · 쿠즈시 (나선으로 이끌기 ×3)", "ja": "結び・崩し" },
      "principle": "kuzushi",
      "durationMs": 800,
      "actors": {
        "nage": { "anim": "tech.shomenuchi_iriminage_ura.nage.lead_shoulder" },
        "uke":  { "anim": "tech.shomenuchi_iriminage_ura.uke.spiral_kuzushi" }
      },
      "tracks": {
        "nage": [
          { "atMs": 0,   "x": 40, "y": -2, "facing": -1, "depth": 9 },
          { "atMs": 800, "x": 36, "y": 0 }
        ],
        "uke": [
          { "atMs": 0,   "x": -20, "y": 2, "facing": -1, "depth": 10 },
          { "atMs": 400, "x": -12, "y": 6, "ease": "Sine.easeInOut" },
          { "atMs": 600, "x": -14, "y": 2, "facing": 1, "ease": "Stepped" },
          { "atMs": 800, "x": -16, "y": 0 }
        ]
      },
      "input": {
        "type": "sequence",
        "breakOn": ["miss"],
        "beats": [
          { "type": "press", "button": "ACTION", "targetMs": 200, "sync": { "actor": "uke", "event": "lead_1" },
            "window": { "early": [-100, -40], "perfect": [-40, 40], "late": [40, 100] } },
          { "type": "press", "button": "ACTION", "targetMs": 400, "sync": { "actor": "uke", "event": "lead_2" },
            "window": { "early": [-100, -40], "perfect": [-40, 40], "late": [40, 100] } },
          { "type": "press", "button": "ACTION", "targetMs": 600, "sync": { "actor": "uke", "event": "rise" },
            "window": { "early": [-100, -40], "perfect": [-40, 40], "late": [40, 100] } }
        ],
        "beatEffects": {
          "perfect": { "score": 50, "musubi": 5, "hitstopMs": 100 },
          "early":   { "musubi": -5, "reaction": { "type": "whiff" } },
          "late":    { "musubi": -5, "reaction": { "type": "pushback", "px": 4 } }
        }
      },
      "outcomes": {
        "perfect": { "goto": "phase:nage", "score": 100, "musubi": 10, "fx": "tech.shomenuchi_iriminage_ura.fx.musubi_ring" },
        "clear":   { "goto": "phase:nage" },
        "miss":    { "goto": "branch:uke_escape", "musubi": -10 }
      }
    },
    {
      "id": "nage",
      "stage": "throw",
      "label": { "ko": "던지기 (베어 내리기)", "ja": "投げ" },
      "principle": "irimi",
      "durationMs": 500,
      "actors": {
        "nage": { "anim": "tech.shomenuchi_iriminage_ura.nage.throw_cut" },
        "uke":  { "anim": "tech.shomenuchi_iriminage_ura.uke.thrown" }
      },
      "tracks": {
        "nage": [
          { "atMs": 0,   "x": 36, "y": 0, "facing": -1, "depth": 10 },
          { "atMs": 200, "x": 28, "y": 0, "ease": "Stepped" },
          { "atMs": 500, "x": 24, "y": 0 }
        ],
        "uke": [
          { "atMs": 0,   "x": -16, "y": 0, "facing": 1, "depth": 9 },
          { "atMs": 200, "x": -24, "y": 0, "ease": "Stepped" },
          { "atMs": 500, "x": -36, "y": 0 }
        ]
      },
      "input": {
        "type": "press",
        "button": "ACTION",
        "targetMs": 200,
        "sync": { "actor": "nage", "event": "cut" },
        "window": { "early": [-150, -50], "perfect": [-50, 50], "late": [50, 150] }
      },
      "outcomes": {
        "perfect": { "goto": "ukemi", "score": 200, "musubi": 20, "hitstopMs": 150, "fx": "common.fx.hit_spark" },
        "early":   { "goto": "ukemi", "score": 50, "reaction": { "type": "whiff" } },
        "late":    { "goto": "ukemi", "score": 50, "reaction": { "type": "clash", "px": 4 } },
        "miss":    { "goto": "branch:uke_escape" }
      }
    }
  ],

  "ukemi": {
    "rules": [
      { "result": "perfect", "minSuccess": 5, "throwGrades": ["perfect"] },
      { "result": "sloppy",  "minSuccess": 3 },
      { "result": "crash" }
    ],
    "results": {
      "perfect": {
        "label": { "ko": "깨끗한 후방낙법 · 잔심", "ja": "受け身・残心" },
        "durationMs": 750,
        "actors": {
          "nage": { "anim": "common.nage.zanshin" },
          "uke":  { "anim": "common.uke.ukemi_back" }
        },
        "tracks": {
          "nage": [{ "atMs": 0, "x": 0, "y": 0, "facing": -1, "depth": 10 }],
          "uke": [
            { "atMs": 0,   "x": -36, "y": 0, "facing": 1, "depth": 9 },
            { "atMs": 500, "x": -52, "y": 0 }
          ]
        },
        "result": { "goto": "end:success", "score": 300, "musubi": 10 }
      },
      "sloppy": {
        "label": { "ko": "흐트러진 낙법", "ja": "乱れた受け身" },
        "durationMs": 750,
        "actors": {
          "nage": { "anim": "common.nage.zanshin" },
          "uke":  { "anim": "common.uke.ukemi_sloppy" }
        },
        "tracks": {
          "nage": [{ "atMs": 0, "x": 0, "y": 0, "facing": -1, "depth": 10 }],
          "uke": [
            { "atMs": 0,   "x": -36, "y": 0, "facing": 1, "depth": 9 },
            { "atMs": 400, "x": -46, "y": 2, "ease": "Stepped" },
            { "atMs": 600, "x": -48, "y": 0 }
          ]
        },
        "result": { "goto": "end:success", "score": 100 }
      },
      "crash": {
        "label": { "ko": "낙법 실패 — 처박힘", "ja": "受け身失敗" },
        "durationMs": 750,
        "actors": {
          "nage": { "anim": "common.nage.zanshin" },
          "uke":  { "anim": "common.uke.crash" }
        },
        "tracks": {
          "nage": [{ "atMs": 0, "x": 0, "y": 0, "facing": -1, "depth": 10 }],
          "uke": [
            { "atMs": 0,   "x": -36, "y": 0, "facing": 1, "depth": 9 },
            { "atMs": 200, "x": -40, "y": 0, "ease": "Stepped" }
          ]
        },
        "result": { "goto": "end:success", "score": 20, "musubi": -20 }
      }
    }
  },

  "branches": {
    "whiff_hit": {
      "label": { "ko": "Early — 성급한 이리미: 헛스윙 후 피격", "ja": "早すぎ" },
      "durationMs": 500,
      "actors": {
        "nage": { "anim": "common.nage.whiff_hit" },
        "uke":  { "anim": "common.uke.shomenuchi_strike" }
      },
      "tracks": {
        "nage": [{ "atMs": 0, "x": 0, "y": 0 }, { "atMs": 500, "x": -8, "y": 0 }],
        "uke":  [{ "atMs": 0, "x": 40, "y": 0 }]
      },
      "result": { "goto": "end:fail", "damage": 10 }
    },
    "clash_pushback": {
      "label": { "ko": "Late — 정면 충돌: 밀려남", "ja": "遅すぎ・衝突" },
      "durationMs": 500,
      "actors": {
        "nage": { "anim": "common.nage.pushed_back" },
        "uke":  { "anim": "common.uke.shomenuchi_strike" }
      },
      "tracks": {
        "nage": [{ "atMs": 0, "x": 0, "y": 0 }, { "atMs": 200, "x": -16, "y": 0, "ease": "Stepped" }, { "atMs": 400, "x": -20, "y": 0 }],
        "uke":  [{ "atMs": 0, "x": 32, "y": 0 }, { "atMs": 400, "x": 44, "y": 0 }]
      },
      "result": { "goto": "end:fail", "damage": 6 }
    },
    "struck": {
      "label": { "ko": "Miss — 무반응 정면타 피격", "ja": "被弾" },
      "durationMs": 400,
      "actors": {
        "nage": { "anim": "common.nage.hit_head" },
        "uke":  { "anim": "common.uke.shomenuchi_strike" }
      },
      "tracks": {
        "nage": [{ "atMs": 0, "x": 0, "y": 0 }, { "atMs": 400, "x": -12, "y": 0 }],
        "uke":  [{ "atMs": 0, "x": 36, "y": 0 }]
      },
      "result": { "goto": "end:fail", "damage": 15 }
    },
    "uke_escape": {
      "label": { "ko": "무스비 단절 — 우케 이탈", "ja": "結びが切れる" },
      "durationMs": 500,
      "actors": {
        "nage": { "anim": "common.nage.kamae" },
        "uke":  { "anim": "common.uke.recover" }
      },
      "tracks": {
        "nage": [{ "atMs": 0, "x": 0, "y": 0 }],
        "uke":  [{ "atMs": 0, "x": -20, "y": 0 }, { "atMs": 500, "x": -64, "y": 0, "facing": 1 }]
      },
      "result": { "goto": "end:fail", "musubi": -20 }
    }
  }
}
